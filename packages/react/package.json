{
  "name": "morph-react",
  "version": "0.0.0",
  "description": "React bindings for the MORPH adaptive UI runtime",
  "license": "MIT",
  "homepage": "https://github.com/yahyeameer/MORPH#readme",
  "bugs": {
    "url": "https://github.com/yahyeameer/MORPH/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahyeameer/MORPH.git",
    "directory": "packages/react"
  },
  "keywords": [
    "adaptive-ui",
    "generative-ui",
    "react",
    "llm",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "morph-core": "workspace:*",
    "motion": "^13.4.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19",
    "react-dom": "19"
  },
  "peerDependencies": {
    "react": "19",
    "react-dom": "19"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  }
}
