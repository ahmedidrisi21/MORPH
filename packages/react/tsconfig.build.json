{
  // Declaration build only: no tests (they import core's test fixtures by path) and core's built
  // types, so tsgo never emits .d.ts files into packages/core/src.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": { "morph-core": ["../core/dist/index.d.ts"] }
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
