{
  "name": "morph-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @morph/demo dev",
    "build": "pnpm -r --filter './packages/*' --if-present build && pnpm --filter @morph/demo build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:golden:live": "MORPH_PROVIDER=jev vitest run --config vitest.golden.config.ts",
    "test:e2e": "pnpm --filter @morph/demo test:e2e",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:golden && pnpm check:boundaries",
    "goal:check": "node scripts/goal-check.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "calibrate": "pnpm --filter @morph/core build && node scripts/calibrate.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
