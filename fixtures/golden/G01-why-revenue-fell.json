          "investigation.by_time",
          "investigation.by_segment",
          "investigation.by_customer"
        ],
        "mustInclude": ["kpi:revenue"],
        "mustNotInclude": ["payroll_panel"]
      },
      "rulesExpect": {
        "outcome": ["auto", "confirm", "alternates", "clarify"]
      }
    }
  ]
}
