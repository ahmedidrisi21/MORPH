{
  "id": "G12-choose-alternate",
  "description": "Choosing an alternate is a local recompose with zero provider calls.",
  "given": {
    "user": {
      "role": "sales_manager",
      "permissions": ["read:sales", "read:customers"]
    },
    "ui": {
      "workspaceId": "overview.default"
    }
  },
  "turns": [
    {
      "intent": "look into customers and revenue"
    },
    {
      "choose": 1,
      "expect": {
        "overrideEvent": true,
        "providerCalls": 0,
        "workspaceChanged": true
      }
    }
  ]
}
