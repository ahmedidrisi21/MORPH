{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "morph",
  "homepage": "https://github.com/yahyeameer/MORPH",
  "items": [
    {
      "name": "morph-registry",
      "type": "registry:lib",
      "title": "Morph demo capabilities",
      "description": "Zod prop schemas and action IDs for the Morph components. Edit to fit your app.",
      "dependencies": ["morph-core", "zod"],
      "files": [
        {
          "path": "lib/morph/registry.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "morph-narrative",
      "type": "registry:lib",
      "title": "Morph narrative client",
      "description": "Fetches verified claims from /api/morph/narrate and falls back to fact sentences.",
      "dependencies": ["morph-core"],
      "files": [
        {
          "path": "lib/narrative/client.tsx",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "morph-kpi",
      "type": "registry:component",
      "title": "MorphKPI",
      "description": "A KPI card: value, delta and direction.",
      "dependencies": ["morph-react", "zod", "lucide-react"],
      "registryDependencies": ["card", "badge", "@morph/morph-registry", "utils"],
      "files": [
        {
          "path": "components/morph/MorphKPI.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "morph-chart",
      "type": "registry:component",
      "title": "MorphChart",
      "description": "Trend and comparison charts on Recharts.",
      "dependencies": ["morph-react", "zod", "recharts"],
      "registryDependencies": ["card", "@morph/morph-registry", "utils"],
      "files": [
        {
          "path": "components/morph/MorphChart.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "morph-table",
      "type": "registry:component",
      "title": "MorphTable",
      "description": "A compact customer table with a filter note.",
      "dependencies": ["morph-react", "zod"],
      "registryDependencies": [
        "card",
        "table",
        "badge",
        "avatar",
        "@morph/morph-registry",
        "utils"
      ],
      "files": [
        {
          "path": "components/morph/MorphTable.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "morph-insight",
      "type": "registry:component",
      "title": "MorphInsight",
      "description": "Verified narrative claims with fact chips and a facts fallback.",
      "dependencies": ["morph-react", "zod", "lucide-react"],
      "registryDependencies": [
        "card",
        "badge",
        "skeleton",
        "@morph/morph-registry",
        "utils",
        "@morph/morph-narrative"
      ],
      "files": [
        {
          "path": "components/morph/MorphInsight.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "morph-action",
      "type": "registry:component",
      "title": "MorphAction",
      "description": "Registered actions only, rendered as buttons.",
      "dependencies": ["morph-react", "zod", "lucide-react"],
      "registryDependencies": ["card", "button", "badge", "@morph/morph-registry", "utils"],
      "files": [
        {
          "path": "components/morph/MorphAction.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "morph-alert",
      "type": "registry:component",
      "title": "MorphAlert",
      "description": "A short alert banner.",
      "dependencies": ["morph-react", "zod", "lucide-react"],
      "registryDependencies": ["@morph/morph-registry", "utils"],
      "files": [
        {
          "path": "components/morph/MorphAlert.tsx",
          "type": "registry:component"
        }
      ]
    }
  ]
}
