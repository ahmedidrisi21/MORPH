# MORPH demo configuration. Copy to apps/demo/.env.local (never commit real keys).
# With no values set, the demo replays recorded decisions and falls back to rules.

MORPH_PROVIDER=replay            # replay | rules | jev | distilled   (default: replay, miss → rules)
MORPH_RECORD=0                   # 1 = when provider=jev, write replay fixtures
TYPESAFE_API_KEY=                # server only
MORPH_JEV_MODEL=jev-1.13.0       # pinned versioned ID
MORPH_NARRATIVE_PROVIDER=none    # none | anthropic | openai  (none → template sentences)
MORPH_NARRATIVE_MODEL=           # required if provider != none; example: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                 # optional OpenAI-compatible server, e.g. https://openrouter.ai/api/v1 (use with provider=openai)
MORPH_DEV_TRACE_FULL=0           # 1 = include lens state content in traces (dev only)
MORPH_TRACE_DIR=                 # e.g. .morph/traces: save traces and events as JSON Lines (ADR 0007)
MORPH_TRACE_LENS=0               # 1 = also save lens output, needed by pnpm research / distill (ADR 0009)
MORPH_DISTILLED_MODEL=           # e.g. .morph/distilled.json from pnpm distill; MORPH_PROVIDER=distilled runs offline

# Optional: share the API rate limit across serverless instances (Upstash Redis REST).
# Without these, each server process keeps its own in-memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
